{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "constructions-supply",
  "main": "src/index.js",
  "compatibility_date": "2025-10-01",
  "assets": { "directory": "./public", "binding": "ASSETS" },
  // No id on purpose: Wrangler creates the KV namespace on first deploy and keeps it linked.
  "kv_namespaces": [{ "binding": "STORE" }],
  // Keeps variables and secrets you add in the Cloudflare dashboard across deploys.
  "keep_vars": true,
  "observability": { "enabled": true }
}
